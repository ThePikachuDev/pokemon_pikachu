; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Pokemon Pikachu"
run/main_scene="uid://dy2msgto4xmnk"
config/features=PackedStringArray("4.4", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

GameManager="*res://scripts/game_manager.gd"
DialogueManager="*res://addons/dialogue_manager/dialogue_manager.gd"
Dialogic="*res://addons/dialogic/Core/DialogicGameHandler.gd"

[dialogic]

directories/dch_directory={
"Hoopa": "res://dialogic_timelines/Hoopa.dch",
"HoopaRingCharacter": "res://dialogic_timelines/HoopaRingCharacter.dch"
}
directories/dtl_directory={
"team_rocket": "res://dialogic_timelines/team_rocket.dtl",
"timeline": "res://dialogic_timelines/timeline.dtl"
}
layout/style_directory={
"": "res://dialogic_timelines/New_File.tres",
"New_File": "res://dialogic_timelines/New_File.tres"
}
glossary/default_case_sensitive=true
layout/style_list=["res://dialogic_timelines/New_File.tres"]
layout/default_style="res://dialogic_timelines/New_File.tres"
variables={}
extensions_folder="res://addons/dialogic_additions"
text/letter_speed=0.01
text/initial_text_reveal_skippable=true
text/text_reveal_skip_delay=0.1
text/advance_delay=0.1
text/autoadvance_per_character_delay=0.1
text/autoadvance_ignored_characters_enabled=true
animations/join_default_length=0.5
animations/join_default_wait=true
animations/leave_default_length=0.5
animations/leave_default_wait=true
animations/cross_fade_default_length=0.5
save/autosave_delay=60.0
save/encryption_on_exports_only=true
choices/autofocus_first=true
choices/delay=0.2
choices/reveal_delay=0
choices/reveal_by_input=false
text/autopauses={}
audio/channel_defaults={}

[dialogue_manager]

runtime/balloon_path="res://dialogue/balloon.tscn"

[editor_plugins]

enabled=PackedStringArray("res://addons/dialogic/plugin.cfg", "res://addons/dialogue_manager/plugin.cfg", "res://addons/godot_super-wakatime/plugin.cfg")

[gui]

theme/custom_font="uid://cowu6k3svsj7s"

